# Operator-reviewed template. Install reviewed binaries/scripts/config first.
[Unit]
Description=Rust native iPhone IPv4 VPN PoC
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ikev2lab
Group=ikev2lab
LoadCredential=master-key:/etc/ikev2lab/master.key
LoadCredential=server-key:/etc/ikev2lab/server-key.pem
LoadCredential=server-chain:/etc/ikev2lab/server-chain.pem
LoadCredential=verifiers:/etc/ikev2lab/verifiers.v1
ExecStart=/usr/local/libexec/ikev2d --serve /etc/ikev2lab/iphone-poc.toml
# Exact reqid ownership only. Reserve the range and stop other instances first.
ExecStopPost=/usr/bin/python3 /usr/local/libexec/harbor-cleanup-xfrm.py --reqid-start 65536 --apply
Restart=no
TimeoutStopSec=15
KillSignal=SIGTERM
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
[Install]
WantedBy=multi-user.target
